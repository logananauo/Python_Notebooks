####--------------------####
### conda basic commands ###
####--------------------####

# create an environment with specific python version
conda create --name (environment name) python=(python version)

# updating conda to latest version
conda update -n base -c defaults conda

# activating an environment 
conda activate (environment name)

# installing more packages later
conda install (package name)

# list all conda environments 
conda env list

# creating an environment from a .yml file
conda create --file (name-of-file.yml)

# remove an environment
conda remove --name (environment name) --all -y

# list Jupyter kernels
jupyter kernelspec list

# remove jupyter kernel
jupyter kernelspec remove (name of kernel)


