#### global code for my two machines
import torch

def get_device():
    if torch.cuda.is_available():
        return torch.device("cuda")
    elif torch.xpu.is_available():
        return torch.device("xpu")
    else:
        return torch.device("cpu")

device = get_device()
print(f"Using device: {device}")
